Vagrant.configure("2") do |config|
  # Box e nome della macchina
  config.vm.box      = "bento/debian-12"
  config.vm.hostname = "vm-sorgente"

  # Rete host-only con IP fisso: è l'indirizzo che userà AWX
  config.vm.network "private_network", ip: "192.168.56.13"

  # Risorse: poche, il Mac ha 8 GB
  config.vm.provider "virtualbox" do |vb|
    vb.name   = "awx-vm-sorgente"
    vb.cpus   = 1
    vb.memory = 1536
  end

  # Provisioning: crea il sorgente Java da prelevare
  config.vm.provision "shell", inline: <<~SHELL
    cat > /home/vagrant/example.java <<'EOF'
    public class example {
        public static void main(String[] args) {
            System.out.println("Hello da AWX -> Jenkins!");
        }
    }
    EOF
    chown vagrant:vagrant /home/vagrant/example.java
  SHELL
end
